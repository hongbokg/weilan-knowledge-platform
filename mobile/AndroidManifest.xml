<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.weilan.knowledge" android:versionCode="13" android:versionName="2.1.9">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
  <queries>
    <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
  </queries>
  <application android:label="蔚蓝助手" android:icon="@drawable/ic_app" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="false" android:hardwareAccelerated="true">
    <provider android:name=".SharedFileProvider" android:authorities="com.weilan.knowledge.sharedfiles" android:exported="false" android:grantUriPermissions="true" />
    <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden" android:windowSoftInputMode="adjustResize">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity>
    <service android:name=".FirewallService" android:permission="android.permission.BIND_VPN_SERVICE" android:exported="true" android:foregroundServiceType="specialUse">
      <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled on-device per-app firewall discards selected applications network traffic without a remote VPN server." />
      <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
    </service>
  </application>
</manifest>
